# Base URL del backend Express (sin barra final)
# Ejemplo local: http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=https://minimarket-api-next.vercel.app/api/v1

# URL canónica del sitio (SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- NextAuth (Fase 7) ---
# Generar secret: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
GITHUB_ID=
GITHUB_SECRET=

# Firebase Auth (Email/Password habilitado en consola)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
